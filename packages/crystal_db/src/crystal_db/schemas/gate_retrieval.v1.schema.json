{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Crystal-DB retrieval gate response",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "ok",
    "error_code",
    "baseline",
    "current",
    "diff",
    "thresholds",
    "reasons",
    "errors"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "gate_retrieval.v1"
      ]
    },
    "run_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "ok": {
      "type": "boolean"
    },
    "error_code": {
      "type": [
        "string",
        "null"
      ]
    },
    "baseline": {
      "type": [
        "object",
        "null"
      ]
    },
    "current": {
      "type": [
        "object",
        "null"
      ]
    },
    "diff": {
      "type": [
        "object",
        "null"
      ]
    },
    "thresholds": {
      "type": [
        "object",
        "null"
      ]
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "errors": {
      "type": [
        "object",
        "null"
      ]
    },
    "report_path": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
