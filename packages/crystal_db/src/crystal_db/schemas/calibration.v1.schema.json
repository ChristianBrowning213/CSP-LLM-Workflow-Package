{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Crystal-DB retrieval calibration response",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "best",
    "results",
    "errors"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "calibration.v1"
      ]
    },
    "run_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "best": {
      "type": [
        "object",
        "null"
      ]
    },
    "results": {
      "type": "array"
    },
    "selection_rule": {
      "type": "string"
    },
    "paths": {
      "type": "object"
    },
    "errors": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "additionalProperties": true
}
