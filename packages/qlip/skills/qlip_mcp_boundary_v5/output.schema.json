{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qlip_mcp_boundary_v5_skill_output",
  "title": "qlip_mcp_boundary_v5_skill_output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "files_changed",
    "tests_run",
    "pytest_result",
    "strictness_confirmed",
    "notes"
  ],
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "files_changed": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "tests_run": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "pytest_result": {
      "type": "string",
      "minLength": 1
    },
    "strictness_confirmed": {
      "type": "boolean"
    },
    "notes": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    }
  }
}
