# Gurobi (use the variables required by your licensed Gurobi installation).
# GRB_LICENSE_FILE=REPLACE_WITH_GUROBI_LICENSE_PATH

# Crystal-DB / Materials Project. An explicit config db_path takes precedence.
MP_API_KEY=REPLACE_WITH_MATERIALS_PROJECT_API_KEY
CRYSTAL_DB_DATA_ROOT=REPLACE_WITH_DATA_DIRECTORY
CRYSTAL_DB_PATH=REPLACE_WITH_SQLITE_INDEX
# CRYSTALDB_PATH is a supported legacy alias; do not set both DB path variables.

# LM Studio-compatible BGE-M3 endpoint (no real credential is bundled).
CRYSTALDB_EMBED_BASE_URL=http://127.0.0.1:1234/v1
CRYSTALDB_EMBED_API_KEY=lm-studio
CRYSTALDB_EMBED_TIMEOUT_S=60
CRYSTALDB_EMBED_BATCH=64
CRYSTALDB_EMBED_RETRIES=3
CRYSTALDB_EMBED_BACKOFF_S=0.5
CRYSTALDB_EMBED_MAX_CTX_TOKENS=4096
CRYSTALDB_EMBED_CHUNK_OVERLAP_TOKENS=128
CRYSTALDB_EMBED_MAX_ITEMS_PER_REQUEST=8
CRYSTALDB_EMBED_MAX_TOTAL_TOKENS_PER_REQUEST=12000
CRYSTALDB_EMBED_CHUNKING=true

# Broad user-supplied regulator/source POT library.
SPP_SOURCE_POT_ROOT=REPLACE_WITH_BROAD_POT_ROOT
SKILL_LOOP_REGULATOR_SPP_ROOT=REPLACE_WITH_CANONICAL_REGULATOR_POT_ROOT

# Optional QLIP override.
QLIP_SOLVER=gurobi
# Optional standalone QLIP scientific asset overrides.
# QLIP_BASE_DATA_DIR=REPLACE_WITH_BASE_CHEMISTRY_DATA
# QLIP_SPP_POT_DIR=REPLACE_WITH_PRIMARY_POT_ROOT
# QLIP_SPP_REGULARISATION_DIR=REPLACE_WITH_REGULATOR_POT_ROOT
# QLIP_SCAFFOLD_CORPUS_ROOT=REPLACE_WITH_SCAFFOLD_CORPUS_ROOT

# Skill-Loop reasoning model (LM Studio, or Ollama's OpenAI-compatible endpoint).
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=lm-studio
LLM_MODEL=REPLACE_WITH_LOADED_REASONING_MODEL
LLM_TIMEOUT_S=60
WORKSPACE_ROOT=.sokllm_workspace
CRYSTALDB_MCP_CMD=python -m crystal_db.mcp.server
SPP_MCP_CMD=python -m spp_maker_mcp.server
QLIP_MCP_CMD=python -m qlip.mcp.server
ALLOWED_READ_ROOTS=.sokllm_workspace
ALLOWED_WRITE_ROOTS=.sokllm_workspace
QLIP_ALLOWED_PATH_ROOTS=REPLACE_WITH_ALLOWED_QLIP_OUTPUT_ROOT
CRYSTALDB_POLICY_MODE=safe

# Ollama source-supported endpoints: OpenAI compatibility at /v1; evidence
# intent-judge helpers use the native /api/tags and /api/chat endpoints.
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_API_KEY=ollama

# Optional SCA backends.
# CASTEP_COMMAND=castep
# SCA_ALIGNN_COMMAND=REPLACE_WITH_ALIGNN_COMMAND
# SCA_M3GNET_MODEL=REPLACE_WITH_MODEL_PATH
# SCA_MACE_MODEL=REPLACE_WITH_MODEL_PATH
# SCA_SEVENNET_MODEL=REPLACE_WITH_MODEL_PATH
# SCA_MLIP_DEVICE=cpu
